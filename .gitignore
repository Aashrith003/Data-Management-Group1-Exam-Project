# Python environments and caches
.venv/
venv/
__pycache__/
*.pyc

# Operating-system and Office temporary files
.DS_Store
Thumbs.db
~$*

# Generated by the pipeline (rebuilt byte-identically with `python pipeline.py` and `python profile.py`).
# They stay in the Moodle ZIP; data/output/quality_metrics.json (with all hashes) stays in Git.
project/data/output/*.csv
project/data/quarantine/*.csv
project/logs/*.jsonl

# Exam deliverables are submitted on Moodle only, not stored in this repository.
*.pptx
*.pdf
GITHUB_LINK.txt

# Source data redistribution: Collisions and Streets show no licence.
# If the group decides NOT to publish the raw snapshots publicly, uncomment the next line.
# Others can re-download them (see README section 3) and verify the SHA-256 hashes.
# project/data/raw/*.csv
